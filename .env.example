# Copy ke .env di root repo (jangan commit .env)
# cp .env.example .env

APPLE_ID=email@example.com
# Password akun Apple ID biasa. AltServer-Linux TIDAK menerima app-specific (xxxx-xxxx-xxxx-xxxx).
APPLE_ID_PASSWORD=your-apple-id-password

# 1 = izinkan reinstall WDA otomatis saat cert expired (butuh kode 2FA di terminal)
# 0 = disarankan setelah WDA sudah terpasang — reinstall manual: install_wda_altserver.sh
IOS_AUTOMATOR_INSTALL_WDA=0
# IOS_ALLOW_WDA_REINSTALL=1

# -----------------------------------------------------------------------------
# stack (umum — IG / X / Facebook)
# -----------------------------------------------------------------------------
IOS_KEEP_SCREEN_ON=1
# IOS_KEEP_AWAKE_SEC=86400
IOS_ENSURE_DEVELOPER_MODE=1
# IOS_SKIP_DEVMODE_CLI_ENABLE=1
# Cleanup: wda | all | none
IOS_CLEANUP_ON_EXIT=wda
# 0 = skip probe cert (~20s). 1 = test launch sebelum stack.
IOS_CHECK_WDA_CERT=0
IOS_WDA_BOOT_WAIT_SEC=12
IOS_WDA_HTTP_WAIT_SEC=30
# IOS_MOUNT_DEV_IMAGE=0
# Anisette: default script = lokal http://127.0.0.1:6969 (docker anisette-v3).
# Publik ani.sidestore.io sering 503 / ALTAppleAPI (17) setelah 2FA.
# ALTSERVER_ANISETTE_SERVER=http://127.0.0.1:6969
# IOS_SKIP_LOCAL_ANISETTE=1
# WDA_DIR=/home/lattepanda/wda
# Bundle id WDA di iPhone (kosong = auto-detect *WebDriverAgentRunner*)
# WDA_BUNDLE=com.yourname.WebDriverAgentRunner.xctrunner
# ALTSERVER_BIN=/home/lattepanda/wda/AltServer

# -----------------------------------------------------------------------------
# instagram  (run_ig_profile.sh)
# -----------------------------------------------------------------------------
# Archive Stories: max screenshot (1–100). YEAR diisi → max PER TAHUN.
IOS_ARCHIVE_MAX_SCREENSHOTS=5
IOS_ARCHIVE_SCROLL_PAUSE_SEC=1.0
# up = jari ke bawah (default). down = jari ke atas.
IOS_ARCHIVE_SCROLL_DIRECTION=up
# Filter tahun inklusif. Kosongkan = tanpa filter.
# IOS_ARCHIVE_YEAR_FROM=2023
# IOS_ARCHIVE_YEAR_TO=2025
# IOS_ARCHIVE_BANNER_MAX_SCROLLS=12

# -----------------------------------------------------------------------------
# x  (run_x_profile.sh)
# -----------------------------------------------------------------------------
IOS_X_MAX_SCREENSHOTS=5
IOS_X_SCROLL_PAUSE_SEC=0.20
IOS_X_SCROLL_DURATION_SEC=0.15
# Fraksi tinggi layar (otomatis menyesuaikan ukuran HP)
IOS_X_SCROLL_DISTANCE=0.78
IOS_X_FIRST_SCROLL_DISTANCE=0.90
# down = jari ke atas (default). up = jari ke bawah.
IOS_X_SCROLL_DIRECTION=down
# 1 = simpan page_source_home/drawer (debug — lambat karena dump tree besar)
# IOS_X_DEBUG_SOURCE=0

# -----------------------------------------------------------------------------
# EDM — iOS Logical Backup + Artifact Acquisition  (python -m edm acquire)
# -----------------------------------------------------------------------------
# Unlock-layer credential for an encrypted iTunes/Finder backup.
# Never written to acquisition.json. Does not make Telegram db_sqlite more likely
# to be included — that is Telegram's backup-exclusion flag.
# IOS_BACKUP_PASSWORD=

# -----------------------------------------------------------------------------
# iLEAPP — parse backup / dump (./scripts/run_ileapp.sh)
# Clone: iLEAPP/ (gitignored). Isolated venv: iLEAPP/.venv
# Default input: latest output/edm_*/evidence/original/<udid>
# Core + Safari/Mail/contacts/Wi-Fi: ./scripts/backup_core.sh --parse
# Browser + email only: ./scripts/backup_browser_mail.sh --parse
# -----------------------------------------------------------------------------
# ILEAPP_INPUT=/path/ke/itunes_backup
# ILEAPP_DIR=  # override clone path (default: ./iLEAPP)
# ILEAPP_PROFILE=ileapp_profiles/core.ilprofile

# -----------------------------------------------------------------------------
# mail  (run_mail_inbox.sh)  — UI saja: inbox yang terlihat
# -----------------------------------------------------------------------------
IOS_MAIL_MAX_SCREENSHOTS=5
IOS_MAIL_SCROLL_PAUSE_SEC=0.45
IOS_MAIL_SCROLL_DURATION_SEC=0.20
IOS_MAIL_SCROLL_DISTANCE=0.72
# down = jari ke atas (lihat email lebih lama)
IOS_MAIL_SCROLL_DIRECTION=down
# 1 = simpan page source tiap scroll (debug)
# IOS_MAIL_DEBUG_SOURCE=0

# -----------------------------------------------------------------------------
# safari history  (run_safari_history.sh) — UI saja: riwayat yang terlihat
# -----------------------------------------------------------------------------
IOS_SAFARI_MAX_SCREENSHOTS=5
IOS_SAFARI_SCROLL_PAUSE_SEC=0.45
IOS_SAFARI_SCROLL_DURATION_SEC=0.20
IOS_SAFARI_SCROLL_DISTANCE=0.72
IOS_SAFARI_SCROLL_DIRECTION=down
# IOS_SAFARI_DEBUG_SOURCE=0

# -----------------------------------------------------------------------------
# facebook  (run_fb_profile.sh)
# -----------------------------------------------------------------------------
# Belum ada knob khusus — Home → Profile saja.
# Cadangan (aktifkan nanti kalau perlu scroll posts FB):
# IOS_FB_MAX_SCREENSHOTS=5
# IOS_FB_SCROLL_PAUSE_SEC=0.35
# IOS_FB_SCROLL_DISTANCE=0.78
# IOS_FB_SCROLL_DIRECTION=down
